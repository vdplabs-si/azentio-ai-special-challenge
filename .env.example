# ─── Required ──────────────────────────────────────────────────────────────
# Voroa Managed PostgreSQL connection URL (Connect tab). Voroa is TLS-only: keep sslmode=require.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require"
# Optional: PEM CA certificate for full verification (otherwise TLS encrypts without CA pinning, per Voroa docs)
# DATABASE_CA_CERT=""

# 32+ random characters. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=""
# Public base URL of this deployment (used for OAuth callbacks, invitation links, CSRF origin checks)
AUTH_URL="http://localhost:3000"

# ─── OAuth (optional — buttons stay disabled until both values are set) ───
# Google: redirect URI  ${AUTH_URL}/api/auth/oauth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# GitHub: callback URL  ${AUTH_URL}/api/auth/oauth/github/callback
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# ─── Email (optional in development; required in production for email codes/invitations) ───
RESEND_API_KEY=""
EMAIL_FROM="azentio.ai <no-reply@your-verified-domain>"

# ─── AIRA via OpenRouter (optional — assistant shows as unavailable without a key) ───
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="anthropic/claude-sonnet-5.5"
# 1 = route only to zero-data-retention endpoints
OPENROUTER_ZDR="0"

# ─── Policy ───────────────────────────────────────────────────────────────
EMPLOYEE_EMAIL_DOMAIN="azentio.com"
# Minimum distinct contributing organisations before shared trend counts are shown
LEARNING_MIN_COHORT="3"
MAX_UPLOAD_MB="5"

# ─── Operations ───────────────────────────────────────────────────────────
# First super administrator (must already have signed up and verified their email). Used by db:sync-catalogue.
BOOTSTRAP_SUPER_ADMIN_EMAIL=""
# Development seed only
SEED_PASSWORD=""
